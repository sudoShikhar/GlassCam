{
  "name": "electron_webcam",
  "version": "1.0.0",
  "description": "A lightweight, modern Electron-based webcam application to test and view your camera feed.",
  "main": "src/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --publish never"
  },
  "build": {
    "appId": "com.sudoShikhar.webapp",
    "asar": true,
    "productName": "WebCam",
    "publish": {
      "provider": "github",
      "owner": "sudoShikhar",
      "repo": "electron_webcam"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "executableArgs": [
        "--no-sandbox"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "WebCam"
    }
  },
  "keywords": [],
  "author": "shikhar <sudoShikhar@users.noreply.github.com>",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
