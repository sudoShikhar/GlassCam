{
  "name": "frontcam",
  "version": "1.0.0",
  "description": "A simple app to test your webcam.",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.sudoShikhar.webapp",
    "asar": true,
    "productName": "WebCam",
    "files": [
      "**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "WebCam"
    }
  },
  "keywords": [],
  "author": "shikhar",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-reload": "^2.0.0-alpha.1"
  }
}
